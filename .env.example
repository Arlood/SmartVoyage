# SmartVoyage 环境变量配置模板
# 使用方法：复制本文件为 .env 并填入真实值
#   cp .env.example .env

# ===== 大模型 API（必填，支持任意 OpenAI 兼容服务）=====
# 切换供应商只需改 BASE_URL + API_KEY（+ 可选 MODEL），示例：
#   阿里云百炼：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   DeepSeek  ：LLM_BASE_URL=https://api.deepseek.com/v1                        LLM_MODEL=deepseek-chat
#   硅基流动  ：LLM_BASE_URL=https://api.siliconflow.cn/v1                      LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# 兼容旧变量名 DASHSCOPE_BASE_URL / DASHSCOPE_API_KEY（LLM_* 优先）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
# 可选：分级模型名（不填则用 config.yaml 默认值）
LLM_MODEL=deepseek-flash
LLM_MODEL_PREMIUM=deepseek-flash
LLM_MODEL_FLASH=deepseek-flash

# ===== 数据库（统一账号 smart_voyage，所有服务共用同一个 MySQL）=====
DB_HOST=localhost
DB_USER=smart_voyage
DB_PASSWORD=
DB_NAME=travel_rag

# ===== 第三方 API Key（可选，不填则对应功能降级）=====
# 和风天气：https://dev.qweather.com/
HEFENG_API_KEY=
# 高德地图：https://lbs.amap.com/
AMAP_API_KEY=
# 博查搜索：https://open.bochaai.com
BOCHA_API_KEY=
# 飞常准：https://mcp.variflight.com/
VARIFLIGHT_API_KEY=

# ===== 第三方 MCP URL=====
AMAP_MCP_URL=https://mcp.amap.com/mcp?key=xxx
TRAIN_MCP_URL=https://mcp.api-inference.modelscope.net/xxx/sse

# ===== JWT 认证密钥（生产环境务必改为随机字符串，建议 32 字节以上）=====
JWT_SECRET=smartvoyage-dev-secret-key-change-in-production
